# Where the Go API runs; app/api/enquiries/route.ts forwards enquiries there (read at runtime).
API_ORIGIN=http://localhost:8080
# Public site URL for canonicals and sitemaps (no trailing slash).
SITE_URL=http://localhost:3000
# Any non-production deployment: keeps it out of search (robots + X-Robots-Tag).
SITE_ENV=preview
# Same value as the API's PROXY_SECRET (server-only, never exposed to the browser).
PROXY_SECRET=
# Rate limiting uses the visitor IP only on Vercel (VERCEL is set automatically there).
# On any other host every visitor shares one limit until route.ts reads that host's trusted IP header.

# Copy to your host's environment (never commit real values).
PORT=8080
# Supabase project: Dashboard → Project Settings → API Keys → "Secret keys" (sb_secret_...).
SUPABASE_URL=https://txcqdsbgejhyfcvamwjm.supabase.co
SUPABASE_SECRET_KEY=
# production: refuse to start without the Supabase settings above.
APP_ENV=production
# Long random string shared with the web app's PROXY_SECRET. Required in production:
# the API rejects calls without it, and only then trusts the visitor IP it is given.
PROXY_SECRET=
# Enquiries per IP per 10 minutes.
RATE_LIMIT=5
